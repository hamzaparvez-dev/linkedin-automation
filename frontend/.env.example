# Strict ICP outreach export (python scripts/export_icp_outreach_csv.py) uses env vars
# documented in the repo root `.env.example` (ICP_OUTREACH_*, ICP_GEO_STRICT, etc.).
#
# Vite proxies /api to http://127.0.0.1:8080 — start the API first, e.g. from repo root:
#   npm run dashboard:dev
# Or only: python3 -m uvicorn dashboard_app.main:app --reload --host 127.0.0.1 --port 8080
#
# Optional: call API on another origin instead of the proxy (leave empty for default)
# VITE_API_BASE=http://127.0.0.1:8080
# If DASHBOARD_API_TOKEN is set on the server, send the same value here:
# VITE_DASHBOARD_TOKEN=your-secret-token
